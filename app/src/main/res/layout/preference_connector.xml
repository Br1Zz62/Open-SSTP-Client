<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Наша большая кнопка Подключить/Отключить -->
    <TextView
        android:id="@+id/connectorButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_connect"
        android:gravity="center"
        android:text="@string/connect"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Системный контейнер, обязателен для корректной работы Preference.
         Размер 0dp × 0dp, потому что нам там ничего не нужно. -->
    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</LinearLayout>