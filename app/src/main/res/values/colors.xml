<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основной синий цвет 1С (акцент) -->
    <color name="blue_primary">#0055A5</color>

    <!-- Более темный синий для нажатий и вариантов -->
    <color name="blue_variant">#004080</color>

    <!-- Фон футера (тёмно-синий, как в ПК-версии) -->
    <color name="footer_bg">#1A3D64</color>

    <!-- Цвета текста и фона -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="background_light">#F5F5F5</color>
    <color name="grey_text">#757575</color>

    <!-- Тема-зависимые цвета -->
    <color name="surface_light">#FFFFFFFF</color>
    <color name="text_light">#1A1A1A</color>

    <!-- Кнопка "Выход" в верхней панели: круглый фон -->
    <color name="close_button_bg">#D5D5D5</color>

    <!-- Цвета для векторных логотипов (переопределяются в values-night) -->
    <color name="brand_text_blue">#1270B3</color>
    <color name="brand_gradient_top">#0D6EC9</color>
    <color name="brand_gradient_bottom">#0653AA</color>

    <!-- Водяной знак "1С" на фоне: очень деликатный серый на белом.
         4% чёрного — почти невидимо, но создаёт «объём» фона, как на ПК. -->
    <color name="brand_watermark">#0A000000</color>

    <!-- Алиасы -->
    <color name="teal_700">@color/blue_primary</color>
    <color name="teal_A700">@color/blue_variant</color>
    <color name="deep_orange_700">@color/blue_primary</color>
    <color name="field_border">#B0BEC5</color>
</resources>