<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения. Мы убрали .DarkActionBar, чтобы контролировать верхнюю панель сами -->
    <style name="Theme.OpenSSTPClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета бренда (синие) -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Вторичные цвета (для переключателей, чекбоксов и т.д.) -->
        <item name="colorSecondary">@color/blue_variant</item>
        <item name="colorSecondaryVariant">@color/blue_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Цвет статус-бара (верхняя полоска телефона с часами и батареей) -->
        <item name="android:statusBarColor">@color/blue_primary</item>

        <!-- Цвет фона всего приложения (светло-серый, как в ПК-версии) -->
        <item name="android:windowBackground">@color/background_light</item>

        <!-- Настройка цвета иконок в статус-баре. false = белые иконки (для темного фона) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Остальные стили оставляем без изменений -->
    <style name="Theme.OpenSSTPClient.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.OpenSSTPClient.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>